                <xs:documentation xml:lang="zh">轨道高度</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="always-show-thumb" type="xs:boolean">
            <xs:annotation>
                <xs:documentation xml:lang="zh">是否总是显示滑块, false时仅鼠标悬浮时显示. 默认为true</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="vertical" type="xs:boolean">
            <xs:annotation>
                <xs:documentation xml:lang="zh">垂直显示</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>

    <xs:attributeGroup name="attri-seek-bar">
        <xs:attribute name="show-lyric-tooltip" type="xs:boolean">
            <xs:annotation>
                <xs:documentation xml:lang="zh">显示歌词提示</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="free-seek" type="xs:boolean">
            <xs:annotation>
                <xs:documentation xml:lang="zh">显示歌词提示时自由定位</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>

    <xs:attributeGroup name="attri-visualization">
        <xs:attribute name="type" type="layout-visual-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">类型</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="spectrum" type="layout-visual-spectrum-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">频谱类型</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="bands" type="xs:int">
            <xs:annotation>
                <xs:documentation xml:lang="zh">频带</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="segs" type="xs:int">
            <xs:annotation>
                <xs:documentation xml:lang="zh">频带分段</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="lo-color" type="layout-color-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">频带颜色1</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="hi-color" type="layout-color-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">频带颜色2</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="mirror" type="xs:boolean">
            <xs:annotation>
                <xs:documentation xml:lang="zh">镜像</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="peak" type="xs:boolean">
            <xs:annotation>
                <xs:documentation xml:lang="zh">峰值保持线(缓动下降的横条)</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="peak-color" type="layout-color-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">峰值线颜色, 默认跟随 hi-color</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="peak-height" type="xs:int">
            <xs:annotation>
                <xs:documentation xml:lang="zh">峰值线高度(px), 默认2</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="peak-gap" type="xs:int">
            <xs:annotation>
                <xs:documentation xml:lang="zh">峰值线与柱顶间距(px), 默认0</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="peak-fall" type="xs:int">
            <xs:annotation>
                <xs:documentation xml:lang="zh">峰值线缓降时间常数(ms), 指数衰减, 默认500, 0为不降</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="peak-hold" type="xs:int">
            <xs:annotation>
                <xs:documentation xml:lang="zh">峰值线到达峰后停留时间(ms), 默认0</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: classic</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="bar-color" type="layout-color-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">频带颜色</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: simple-bar</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="thickness" type="xs:float">
            <xs:annotation>
                <xs:documentation xml:lang="zh">轮廓宽度</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: wave</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="grow" type="xs:float">
            <xs:annotation>
                <xs:documentation xml:lang="zh">轮廓辉光</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: wave</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="grow-radius" type="xs:float">
            <xs:annotation>
                <xs:documentation xml:lang="zh">轮廓辉光半径</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: wave</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="fade-width" type="layout-size-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">轮廓两端淡出宽度, 百分比(相对元素宽度)或像素值, 默认0不淡出</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: wave</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="back-color" type="layout-color-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">填充颜色</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: wave</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="back-outline-color" type="layout-color-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">轮廓颜色</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: wave</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="front-color" type="layout-color-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">填充颜色</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: wave</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="front-outline-color" type="layout-color-type">
            <xs:annotation>
                <xs:documentation xml:lang="zh">轮廓颜色</xs:documentation>
                <xs:documentation xml:lang="zh">可用频谱类型: wave</xs:documentation>
                <xs:documentation xml:lang="en"></xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>

    <xs:attributeGroup name="attri-all">
        <xs:attributeGroup ref="attri-common"></xs:attributeGroup>
        <xs:attributeGroup ref="attri-command"></xs:attributeGroup>
        <xs:attributeGroup ref="attri-container"></xs:attributeGroup>
        <xs:attributeGroup ref="attri-label"></xs:attributeGroup>
        <xs:attributeGroup ref="attri-albumart"></xs:attributeGroup>
        <xs:attributeGroup ref="attri-lyric"></xs:attributeGroup>
        <xs:attributeGroup ref="attri-button"></xs:attributeGroup>
    </xs:attributeGroup>
</xs:schema>
